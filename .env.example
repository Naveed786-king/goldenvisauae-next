# ---------------------------------------------
# Golden Visa UAE - environment settings
# Copy this file to ".env" and change the values
# ---------------------------------------------

# Database. Default = SQLite file (no database server needed).
# For MySQL (cPanel/Hostinger) see README: DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
DATABASE_URL="file:./data.db"

# Long random secret used to sign login sessions. CHANGE THIS!
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# In production: NEXT_PUBLIC_SITE_URL="https://goldenvisauae.ai"

# First admin account (created by the seed on first run)
ADMIN_EMAIL="admin@goldenvisauae.ai"
ADMIN_PASSWORD="Admin@12345"

# Where uploaded files are stored (relative to the project folder)
UPLOAD_DIR="uploads"

# Translation engine for the 8 languages without a built-in pack (AR and RU are built in).
# Default: free Google engine, no key needed. Optional: set a Gemini key (or enter it in Admin → Languages).
# TRANSLATION_PROVIDER="google"   # google | gemini | claude | deepl | off
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"


# Email notifications (SMTP) and Google Search Console verification are set in the Admin panel:
#   Admin → Site settings → "Email (SMTP)" and "SEO" tabs.
